@startuml
title Restaurant Rush - Stage 3 Class Diagram
top to bottom direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 35
skinparam ranksep 45
skinparam packageStyle rectangle
hide empty members

class RestaurantCLI #f7eab8 {
  -controller: GameController
  +readWaiterChoice() String
  +readChefChoice() String
  +readHostChoice() String
  +readHappyHourChoice() boolean
  +displayTurnStatus(Restaurant) void
  +displayError(String) void
  +displayResult(boolean, Restaurant) void
}

class GameController #f7eab8 {
  -restaurant: Restaurant
  -schedule: ArrivalSchedule
  -currentTurn: int
  -maxTurns: int
  -cli: RestaurantCLI
  +startGame() void
  -executeTurn() void
  -processHappyHourActivation() void
  -applyHappyHourRecovery() void
  -processScheduledArrival() void
  -coordinateStaffActions() void
  -coordinateHostAction() void
  -coordinatePaymentProcessing() void
  -processEndOfTurnUpdates() void
  -evaluateGameResult() boolean
}

class ArrivalSchedule {
  -arrivalTurns: int[]
  -nextCustomerId: int
  +isArrivalTurn(turn: int) boolean
  +createArrival(turn: int) Customer
}

class Restaurant #f7eab8 {
  -tables: List<Table>
  -customers: List<Customer>
  -waitingQueue: Queue<Customer>
  -menu: Menu
  -happyHour: HappyHour
  -waiter: Waiter
  -chef: Chef
  -cashier: Cashier
  -host: Host
  -revenueCents: int
  +registerArrival(Customer) void
  +findAvailableTable() Table
  +getMenu() Menu
  +getHappyHour() HappyHour
  +getWaiter() Waiter
  +getChef() Chef
  +getCashier() Cashier
  +getHost() Host
  +recordPayment(amountCents: int) void
  +releaseTableOf(Customer) void
  +getPaidCustomerCount() int
  +getAverageSatisfaction() double
  +getRevenueCents() int
  +handleAbandonment(Customer) void
  +getUnhappyDepartureCount() int
}

class HappyHour #d6efdc {
  -DISCOUNT_PERCENT: int = 20
  -RECOVERY: int = 15
  -DURATION: int = 2
  -used: boolean
  -remainingTurns: int
  +activate() boolean
  +isActive() boolean
  +isAvailable() boolean
  +getRemainingTurns() int
  +applyDiscount(cents: int) int
  +getRecoveryAmount() int
  +endTurn() void
}

class Menu #f7eab8 {
  -items: List<MenuItem>
  +getItems() List<MenuItem>
  +getItem(index: int) MenuItem
  +size() int
  +getMostExpensive() MenuItem
}

class MenuItem {
  -name: String
  -priceCents: int
  -preparationUnits: int
  +getName() String
  +getPriceCents() int
  +getPreparationUnits() int
  +MenuItem(name: String, priceCents: int, preparationUnits: int)
}

class ComboMeal #d6efdc {
  -first: MenuItem
  -second: MenuItem
  +ComboMeal(first: MenuItem, second: MenuItem)
  +getComponents() List<MenuItem>
}

class Host #d6efdc {
  +seatCustomer(Customer, Table) void
}

class Waiter #f7eab8 {
  +seatCustomer(Customer, Table) void
  +takeOrder(Customer, Menu, HappyHour, currentTurn: int) Order
  +serveOrder(Customer, currentTurn: int) void
}

class Chef {
  +prepare(Order) void
}

class Cashier {
  +processPayment(Customer, Restaurant) void
}

class Table {
  -tableId: int
  -occupant: Customer
  +isAvailable() boolean
  +seat(Customer) void
  +release() void
  +getOccupant() Customer
}

abstract class Customer #f7eab8 {
  -customerId: int
  #satisfaction: int
  -status: CustomerStatus
  -order: Order
  -servedTurn: int
  -readyTurn: int
  +getId() int
  +getStatus() CustomerStatus
  +getSatisfaction() int
  {abstract} +getTypeLabel() : String
  +chooseMenuItem(Menu) MenuItem
  +calculateBillCents(basePriceCents: int) int
  {abstract} #getSatisfactionLoss() : int
  #adjustSatisfaction(delta: int) void
  +reduceSatisfaction() void
  +recoverSatisfaction(amount: int) void
  +isAwaitingService() boolean
  +onServed(turnsWaited: int) void
  +assignOrder(Order) void
  +markSeated() void
  +getOrder() Order
  +markServed(turn: int) void
  +markReadyToPay(turn: int) void
  +getServedTurn() int
  +getReadyTurn() int
  +markPaid() void
  +shouldAbandon() boolean
  +markAbandoned() void
}

class RegularCustomer {
  +getTypeLabel() String
  #getSatisfactionLoss() int
}

class VIPCustomer {
  +getTypeLabel() String
  #getSatisfactionLoss() int
  +calculateBillCents(basePriceCents: int) int
}

class CriticCustomer {
  -LATE_SERVICE_TURNS: int
  -LATE_PENALTY: int
  +getTypeLabel() String
  #getSatisfactionLoss() int
  +chooseMenuItem(Menu) MenuItem
  +onServed(turnsWaited: int) void
}

class Order {
  -orderId: int
  -item: MenuItem
  -completedUnits: int
  -status: OrderStatus
  -billCents: int
  -turnTaken: int
  +Order(item: MenuItem, billCents: int, turnTaken: int)
  +advancePreparation() void
  +isReady() boolean
  +markServed() void
  +markPaid() void
  +cancel() void
  +getStatus() OrderStatus
  +getBillCents() int
  +getTurnTaken() int
}

enum CustomerStatus {
  WAITING
  SEATED
  ORDERED
  SERVED
  READY_TO_PAY
  PAID
  ABANDONED
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

' Association and inheritance relationships
RestaurantCLI "1" -- "1" GameController : uses
GameController "1" --> "1" Restaurant : coordinates
GameController "1" --> "1" ArrivalSchedule : asks for arrivals
ArrivalSchedule ..> Customer : creates
Restaurant "1" *-- "2" Table : contains
Restaurant "1" *-- "1" Menu : offers
Restaurant "1" *-- "1" HappyHour : runs
Menu "1" o-- "5" MenuItem : lists
MenuItem <|-- ComboMeal
ComboMeal "1" o-- "2" MenuItem : components
Restaurant "1" o-- "0..*" Customer : tracks
Restaurant "1" -- "1" Waiter : employs
Restaurant "1" -- "1" Chef : employs
Restaurant "1" -- "1" Cashier : employs
Restaurant "1" -- "1" Host : employs
Table "1" -- "0..1" Customer : occupied by
Customer "1" -- "0..1" Order : places
Order "0..*" --> "1" MenuItem : selects
Customer <|-- RegularCustomer
Customer <|-- VIPCustomer
Customer <|-- CriticCustomer
Customer --> CustomerStatus
Order --> OrderStatus
Host ..> Table : seats
Host ..> Customer : seats
Waiter ..> Table : seats
Waiter ..> Customer : serves
Waiter ..> Order : creates / serves
Waiter ..> HappyHour : applies discount
Chef ..> Order : prepares
Cashier ..> Customer : processes payment

note right of Customer
  Customer types are polymorphic. Regular/VIP/Critic waiting loss: 8/5/12. Satisfaction is clamped to 0..100.
end note

note right of Order
  Bill is fixed when order is created. Legal transitions: PLACED to PREPARING to READY to SERVED to PAID; cancellation before service.
end note

note right of CriticCustomer
  Chooses the most expensive item on Menu and receives extra late-service penalty when served after 2 turns.
end note

note right of ComboMeal
  Two existing MenuItem components; price is 90 percent of their combined price; preparation units add. Shared components are aggregated.
end note

note right of Menu
  Regular customer choice may select combo items. Critic selects the most expensive item from the menu, including combos.
end note

note right of HappyHour
  Activates once for two turns; 20 percent new-order discount and waiting satisfaction recovery.
end note

@enduml
