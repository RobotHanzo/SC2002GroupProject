@startuml
' ======================================================================
' SC2002 Restaurant Rush - Stage 2 class diagram (source of truth)
' Colour key: green = new in Stage 2, yellow = changed since Stage 1, blue = unchanged
' Render: PlantUML 1.2025.4 with the built-in Smetana layout (no Graphviz), SVG printed to PDF
' ======================================================================
!pragma layout smetana
title Restaurant Rush: Stage 2 class diagram

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam nodesep 28
skinparam ranksep 38
skinparam linetype polyline
skinparam ArrowColor #333333
skinparam noteBackgroundColor #F6F7F2
skinparam noteBorderColor #8C8C80
skinparam noteFontSize 11
skinparam class {
  BorderColor #3F6B96
  BackgroundColor #DCEBF7
}
skinparam stereotypeCBackgroundColor transparent
hide empty members
hide circle

' ---------- boundary and control ----------
class RestaurantCLI <<boundary>> #FAE8A6 {
  -controller: GameController
  -input: Scanner
  -out: PrintStream
  -echoInput: boolean
  +RestaurantCLI(in: InputStream, out: PrintStream, echoInput: boolean)
  +start(): void
  +readWaiterChoice(): String
  +readChefChoice(): String
  +displayTurnStatus(Restaurant): void
  +displayMessage(String): void
  +displayError(String): void
  +displayResult(boolean, Restaurant): void
  -readLine(prompt: String): String
  {static} -averageText(Restaurant): String
  {static} -queueText(Restaurant): String
  {static} -tablesText(Restaurant): String
  {static} -orderText(Customer): String
  {static} -waiterTasksText(Restaurant): String
  {static} -chefTasksText(Restaurant): String
  {static} -withStatus(restaurant: Restaurant, status: CustomerStatus, readyOnly: boolean): List<Customer>
  {static} -ids(customers: List<Customer>): String
}

class GameController <<control>> #FAE8A6 {
  {static} +REQUIRED_PAID_CUSTOMERS: int = 4
  {static} +REQUIRED_REVENUE_CENTS: int = 4500
  {static} +REQUIRED_AVERAGE_SATISFACTION: int = 60
  {static} -MAX_TURNS: int = 18
  -restaurant: Restaurant
  -schedule: ArrivalSchedule
  -currentTurn: int
  -maxTurns: int
  -cli: RestaurantCLI
  +GameController(cli: RestaurantCLI)
  +startGame(): void
  +getCurrentTurn(): int
  +getMaxTurns(): int
  -executeTurn(): void
  -processScheduledArrival(): void
  -coordinateStaffActions(): void
  -coordinatePaymentProcessing(): void
  -processEndOfTurnUpdates(): void
  -evaluateGameResult(): boolean
  -chooseUntilAccepted(reader: Supplier<String>, task: Consumer<String>): void
  -performWaiterTask(choice: String): void
  -performChefTask(choice: String): void
  -seatQueuedCustomer(command: Command, seater: BiConsumer<Customer, Table>, actor: String): void
  -takeOrder(command: Command): void
  -serve(command: Command): void
  -prepare(command: Command): void
  -select(command: Command, candidates: List<Customer>, noCandidates: String, ineligible: String): Customer
  -customersWithStatus(status: CustomerStatus): List<Customer>
  {static} -idList(customers: Collection<Customer>): String
  {static} -describe(customer: Customer): String
}

class ArrivalSchedule #CCEBD2 {
  -arrivalTurns: int[]
  -nextCustomerId: int
  -customerTypes: List<IntFunction<Customer>>
  +isArrivalTurn(turn: int): boolean
  +createArrival(turn: int): Customer
  -indexOf(turn: int): int
}

' ---------- restaurant and menu ----------
class Restaurant #FAE8A6 {
  {static} -TABLE_COUNT: int = 2
  -tables: List<Table>
  -customers: List<Customer>
  -waitingQueue: Queue<Customer>
  -menu: Menu
  -waiter: Waiter
  -chef: Chef
  -cashier: Cashier
  -revenueCents: int
  +Restaurant()
  +registerArrival(Customer): void
  +findAvailableTable(): Table
  +findOldestEligiblePayer(turn: int): Customer
  +getMenu(): Menu
  +getWaiter(): Waiter
  +getChef(): Chef
  +getCashier(): Cashier
  +getTables(): List<Table>
  +getCustomers(): List<Customer>
  +getWaitingQueue(): Queue<Customer>
  +recordPayment(amountCents: int): void
  +releaseTableOf(Customer): void
  +getPaidCustomerCount(): int
  +getServedCustomerCount(): int
  +getAverageSatisfaction(): double
  +getRevenueCents(): int
  +handleAbandonment(Customer): void
  +getUnhappyDepartureCount(): int
  -countWithStatus(status: CustomerStatus): int
}

class Menu #CCEBD2 {
  -items: List<MenuItem>
  +Menu(items: List<MenuItem>)
  +getItems(): List<MenuItem>
  +getItem(index: int): MenuItem
  +size(): int
  +getMostExpensive(): MenuItem
}

class MenuItem {
  -name: String
  -priceCents: int
  -preparationUnits: int
  +MenuItem(name: String, priceCents: int, preparationUnits: int)
  +getName(): String
  +getPriceCents(): int
  +getPreparationUnits(): int
}

' ---------- staff and table ----------
class Waiter #FAE8A6 {
  +seatCustomer(Customer, Table): void
  +takeOrder(Customer, Menu, currentTurn: int): Order
  +serveOrder(Customer, currentTurn: int): void
}

class Chef {
  +prepare(Order): void
}

class Cashier #FAE8A6 {
  +processPayment(Customer, Restaurant): void
}

class Table {
  -tableId: int
  -occupant: Customer
  +Table(tableId: int)
  +getTableId(): int
  +isAvailable(): boolean
  +seat(Customer): void
  +release(): void
  +getOccupied(): Customer
}

' ---------- customers ----------
abstract class Customer #FAE8A6 {
  {static} -MAX_SATISFACTION: int = 100
  -customerId: int
  -satisfaction: int
  -status: CustomerStatus
  -order: Order
  -servedTurn: int
  -readyTurn: int
  #Customer(customerId: int)
  +getId(): int
  +getStatus(): CustomerStatus
  +getSatisfaction(): int
  {abstract} +getTypeLabel(): String
  +chooseMenuItem(Menu): MenuItem
  +calculateBillCents(basePriceCents: int): int
  {abstract} #getSatisfactionLoss(): int
  #adjustSatisfaction(delta: int): void
  +reduceSatisfaction(): void
  +onServed(turnsWaited: int): void
  +assignOrder(Order): void
  +getOrder(): Order
  +markSeated(): void
  +markServed(turn: int): void
  +canFinishEating(turn: int): boolean
  +markReadyToPay(turn: int): void
  +canPay(turn: int): boolean
  +markPaid(): void
  +shouldAbandon(): boolean
  +markAbandoned(): void
  -isAwaitingService(): boolean
  -require(expected: CustomerStatus): void
}

class RegularCustomer #CCEBD2 {
  {static} -SATISFACTION_LOSS: int = 8
  +RegularCustomer(customerId: int)
  +getTypeLabel(): String
  #getSatisfactionLoss(): int
}

class VIPCustomer #CCEBD2 {
  {static} -SATISFACTION_LOSS: int = 5
  {static} -PRICE_PERCENT: int = 90
  +VIPCustomer(customerId: int)
  +getTypeLabel(): String
  #getSatisfactionLoss(): int
  +calculateBillCents(basePriceCents: int): int
}

class CriticCustomer #CCEBD2 {
  {static} -SATISFACTION_LOSS: int = 12
  {static} -LATE_SERVICE_TURNS: int = 2
  {static} -LATE_PENALTY: int = 10
  +CriticCustomer(customerId: int)
  +getTypeLabel(): String
  #getSatisfactionLoss(): int
  +chooseMenuItem(Menu): MenuItem
  +onServed(turnsWaited: int): void
}

class Order #FAE8A6 {
  {static} -nextOrderId: int = 1
  -orderId: int
  -item: MenuItem
  -completedUnits: int
  -status: OrderStatus
  -billCents: int
  -turnTaken: int
  +Order(item: MenuItem, billCents: int, turnTaken: int)
  +advancePreparation(): void
  +isReady(): boolean
  +markServed(): void
  +markPaid(): void
  +cancel(): void
  +getStatus(): OrderStatus
  +getOrderId(): int
  +getItem(): MenuItem
  +getCompletedUnits(): int
  +getBillCents(): int
  +getTurnTaken(): int
  -require(expected: OrderStatus, action: String): void
}

enum CustomerStatus #EAF1F7 {
  WAITING
  SEATED
  ORDERED
  SERVED
  READY_TO_PAY
  PAID
  ABANDONED
}

enum OrderStatus #EAF1F7 {
  PLACED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

' ---------- entry point, utility and nested class ----------
class Main <<entry point>> {
  -Main()
  {static} +main(args: String[]): void
}

class Money <<utility>> #EAF1F7 {
  -Money()
  {static} +format(cents: int): String
}

class Command <<nested in GameController>> {
  -verb: String
  -customerId: Integer
  -Command(verb: String, customerId: Integer)
  {static} -parse(raw: String): Command
}

' ---------- layout skeleton (hidden links keep the rows tidy) ----------
' Smetana cannot route labelled same-rank links, so sideways links carry no mid-link label.
GameController -[hidden]right- ArrivalSchedule
Main -[hidden]right- RestaurantCLI
RestaurantCLI -[hidden]right- Money
Table -[hidden]right- Waiter
Waiter -[hidden]right- Chef
Chef -[hidden]right- Cashier
Cashier -[hidden]right- Menu
Customer -[hidden]right- Order
Order -[hidden]right- MenuItem
RegularCustomer -[hidden]right- VIPCustomer
VIPCustomer -[hidden]right- CriticCustomer
CriticCustomer -[hidden]right- CustomerStatus

' ---------- control and boundary ----------
RestaurantCLI "cli 1" <-down-> "controller 1" GameController
GameController "1" -right-> "schedule 1" ArrivalSchedule
GameController "1" -down-> "restaurant 1" Restaurant
RestaurantCLI .down.> Restaurant : displays
ArrivalSchedule .down.> Customer : <<create>>\nRegular, VIP, Critic

Main .[#777777]right.> RestaurantCLI : <<create>>
RestaurantCLI .[#777777]right.> Money
GameController .[#777777]up.> Money
GameController +-up- Command

' ---------- composition (Restaurant owns these) ----------
Restaurant "1" *-down- "2" Table : tables
Restaurant "1" *-down- "1" Waiter : waiter
Restaurant "1" *-down- "1" Chef : chef
Restaurant "1" *-down- "1" Cashier : cashier
Restaurant "1" *-down- "1" Menu : menu

' ---------- aggregation (customers arrive and leave) ----------
' Multiplicities at the Customer end sit in the labels: three links meet at Customer's corner and end labels would overlap there.
Restaurant "1" o-down- Customer : customers [0..*]
Restaurant "1" o-down- Customer : waitingQueue [0..*]\n{ordered, FIFO}

' ---------- menu ----------
Menu "1" o-down- "3" MenuItem : items

' ---------- domain associations ----------
Table "1" -down-> Customer : occupant [0..1]
Customer "1" -right-> Order : order [0..1]
Order "0..*" -right-> "1" MenuItem
Customer -down-> CustomerStatus : status
Order -down-> OrderStatus : status
Customer <|-down- RegularCustomer
Customer <|-down- VIPCustomer
Customer <|-down- CriticCustomer

' ---------- dependencies ----------
GameController .[#777777].> Waiter
GameController .[#777777].> Chef
GameController .[#777777].> Cashier
GameController .[#777777].> Customer
Waiter .left.> Table
Waiter .down.> Customer : seats / serves
Waiter .down.> Order : <<create>>
Waiter .down.> Menu : reads
Chef .down.> Order : advances
Cashier .down.> Customer : charges
Cashier .down.> Order : reads bill
Cashier .up.> Restaurant : recordPayment,\nreleaseTableOf
Customer .up.> Menu : chooses from

' ---------- annotations ----------
note top of Restaurant
  <b>COMPOSITION</b>
  Restaurant creates and owns its Tables, Menu and
  staff; they exist only as part of one Restaurant.
  Customers are aggregated: they arrive and leave.
  The waitingQueue and customers links both point
  at Customer.
end note

note bottom of Order
  <b>ENCAPSULATION</b>
  status is private and changes only through
  advancePreparation(), markServed(), markPaid(),
  cancel(); illegal transitions are rejected.
  Legal: PLACED → PREPARING → READY → SERVED → PAID
  (PLACED → READY directly for a 1-unit dish);
  PLACED / PREPARING / READY → CANCELLED if the
  customer leaves.
  billCents is set once in the constructor with no
  setter: the price is locked when ordered.
end note

note bottom of CustomerStatus
  <b>CUSTOMER LIFECYCLE</b>
  WAITING → SEATED → ORDERED → SERVED →
  READY_TO_PAY → PAID; WAITING / SEATED / ORDERED
  → ABANDONED when satisfaction reaches 0.
  Served, eating and READY_TO_PAY customers
  lose no satisfaction.
end note

note left of Customer
  <b>POLYMORPHISM</b>
  getSatisfactionLoss(), calculateBillCents(),
  chooseMenuItem() and onServed() are overridden.
  GameController and Waiter call them on Customer
  and never check the type.
  Loss per waiting turn: Regular 8, VIP 5, Critic 12.
  <b>FOOD CHOICE</b>
  Regular and VIP: menu.getItem(customerId % menu.size()).
  Critic overrides it (see CRITIC RULE).
  <b>ENCAPSULATION</b>
  satisfaction is private; subclasses change it only
  through adjustSatisfaction() (clamped 0..100).
  <b>TURN GUARDS</b>
  canFinishEating(turn): only after the serving turn.
  canPay(turn): only after the READY_TO_PAY turn.
end note

note right of Waiter
  <b>BILLING</b>
  takeOrder(): bill = customer.calculateBillCents(price),
  stored in the new Order (VIP pays 90%).
end note

note right of CriticCustomer
  <b>CRITIC RULE</b>
  Loses 12 per waiting turn. Always orders the most
  expensive menu item (Pasta, $18.00). Served more
  than 2 turns after ordering: loses an extra 10
  (onServed).
end note

note left of RegularCustomer #E8E8E8
  <b>KEY</b>
  <back:#CCEBD2>  green  </back> new in Stage 2
  <back:#FAE8A6>  yellow  </back> changed since Stage 1
  <back:#DCEBF7>  blue  </back> unchanged
  <b>Changed since Stage 1</b>
  Customer: abstract; chooseMenuItem(List<MenuItem>) to
    chooseMenuItem(Menu); + loss, billing and onServed hooks
  Order: getPriceCents() to getBillCents(); + billCents, turnTaken
  Waiter: takeOrder(Customer, MenuItem): void to
    takeOrder(Customer, Menu, turn): Order; serveOrder calls onServed
  Cashier: charges order.getBillCents()
  Restaurant: registerArrival(): Customer to registerArrival(Customer);
    menuItems / getMenuItems() replaced by menu / getMenu()
  GameController: + schedule; RestaurantCLI: shows type and bill
  <b>Complete:</b> every attribute, constructor and operation in
  the Stage 2 code is listed (underlined = static; private
  helpers included).
end note
@enduml
